<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.wexa</groupId>
  <artifactId>cognodb-benchmark</artifactId>
  <version>1.0.0</version>
  <build>
    <finalName>cognodb-benchmark</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer>
                  <mainClass>ai.wexa.benchmark.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <neo4j.driver.version>5.24.0</neo4j.driver.version>
    <jackson.version>2.17.2</jackson.version>
    <maven.compiler.target>17</maven.compiler.target>
    <nebula.client.version>3.8.2</nebula.client.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <arangodb.driver.version>7.16.0</arangodb.driver.version>
    <dotenv.version>3.2.0</dotenv.version>
  </properties>
</project>
