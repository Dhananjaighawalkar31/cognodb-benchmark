# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- CognoDB Cloud (console.cognodb.com) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free (console.neo4j.io) ---
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# --- Memgraph Cloud (console.memgraph.com) ---
MEMGRAPH_URI=bolt+s://<instance-id>.cloud.memgraph.com:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- ArangoDB Oasis (cloud.arangodb.com) ---
ARANGO_HOST=<instance-id>.arangodb.cloud
ARANGO_PORT=8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark

# --- Nebula Graph (self-hosted via docker/docker-compose.nebula.yml) ---
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=benchmark
